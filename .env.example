# FTEC5660 Mem0 Reproduction Environment
# Copy this file to .env and replace the placeholders with your own values.
# Never commit the actual .env file.

# DeepSeek API key for the Dockerized Mem0 OSS server
DEEPSEEK_API_KEY=your_deepseek_api_key

# OpenAI-compatible API configuration for the LOCOMO Answerer and Judge
OPENAI_API_KEY=your_deepseek_api_key
OPENAI_BASE_URL=https://api.deepseek.com

# Local Mem0 OSS server
MEM0_HOST=http://localhost:8888
MEM0_BACKEND=oss

# Local Qdrant
QDRANT_PORT=6333
